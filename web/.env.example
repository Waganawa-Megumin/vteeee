# Base path for GitHub Pages project sites (served under /<repo>/).
# Leave unset for local dev; the Pages workflow sets VITE_BASE=/vteeee/.
# VITE_BASE=/vteeee/

# Optional: pre-configure a proxy base URL so a build runs in Live mode by default.
# Leave UNSET for the public github.io demo (it stays a demo with sample data).
# Live mode can also be enabled at runtime via the in-app Settings dialog.
# VITE_API_BASE_URL=https://your-proxy.example.workers.dev
