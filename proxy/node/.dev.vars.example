# Copy to .dev.vars (gitignored) and fill in. Loaded by the Node proxy.
VT_API_KEY=
# Optional — enables Claude smart-parse (falls back to regex if unset):
ANTHROPIC_API_KEY=
# Optional — enables Shodan OSINT context on IP rows (ports / services / CVEs):
SHODAN_API_KEY=
# Optional — per-minute cap on Shodan host lookups (free plan ≈ 1/s → 60):
# SHODAN_RPM=60
# Optional — MaxMind GeoIP geolocation + map on IP rows (HTTP Basic: account ID + license key):
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# GeoLite2 (free) users: set MAXMIND_BASE_URL=https://geolite.info (+ MAXMIND_EDITION=city)
# MAXMIND_BASE_URL=https://geoip.maxmind.com
# Edition: insights (default — richest) / city / country (needs a matching license):
# MAXMIND_EDITION=insights
# MAXMIND_RPM=60
# Optional — DomainTools Iris (domains → Enrich, IPs → Investigate reverse). BOTH needed:
DOMAINTOOLS_API_USERNAME=
DOMAINTOOLS_API_KEY=
# DOMAINTOOLS_RPM=30
# Optional — DNSLytics (IPs → IPInfo, domains → DomainInfo):
DNSLYTICS_API_KEY=
# Override only if your DNSLytics endpoint differs from the default:
# DNSLYTICS_BASE_URL=https://api.dnslytics.net/v1
# DNSLYTICS_RPM=60
# Optional — Intel 471 (Titan): BasicAuth = API email (login) + API key (password):
INTEL471_API_USER=
INTEL471_API_KEY=
# INTEL471_BASE_URL=https://api.intel471.com/v1
# INTEL471_RPM=60
# Optional — CYFIRMA DeCYFIR (Risk Dossier + STIX attribution; key = the `key=` query param):
CYFIRMA_API_KEY=
# CYFIRMA_BASE_URL=https://decyfir.cyfirma.com/core/api-ua
# CYFIRMA_RPM=30
# Optional — TeamT5 ThreatVision (APT attribution). OAuth2 client credentials (preferred)...
THREATVISION_CLIENT_ID=
THREATVISION_CLIENT_SECRET=
# ...or a pre-obtained access token instead of client id/secret:
# THREATVISION_ACCESS_TOKEN=
# THREATVISION_BASE_URL=https://api.threatvision.org
# NOTE: IP/domain detail cost 1 AAP each; hash lookups (samples search) cost 0 AAP.
# THREATVISION_RPM=30
# Optional — SOC Prime (TDM): personal API key for Uncoder AI IOC → SIEM query generation:
SOCPRIME_API_KEY=
# SOCPRIME_BASE_URL=https://api.tdm.socprime.com
# Optional — Recorded Future (X-RFToken). Connect risk intel on every IOC + on-demand
# threat-actor/malware pivots, sandbox summaries (read-only) and Sigma/YARA/Snort rules:
RECORDEDFUTURE_API_KEY=
# RECORDEDFUTURE_BASE_URL=https://api.recordedfuture.com
# RECORDEDFUTURE_RPM=30
# Optional — urlscan.io on-demand "魚拓" for URL/domain rows (sandboxed screenshot + resolved IP +
# contacted hosts + verdict). The scan runs from urlscan's infra, not your egress:
URLSCAN_API_KEY=
# Default submission visibility: public / unlisted (default) / private
# URLSCAN_VISIBILITY=unlisted
# OPSEC: `public` is clamped to `unlisted` unless you set this to true. Keep OFF for covert work.
# URLSCAN_ALLOW_PUBLIC=false
# OPSEC: keep tags EMPTY — urlscan tags are searchable and would let anyone cluster your scans.
# URLSCAN_TAGS=
# URLSCAN_BASE_URL=https://urlscan.io
# Shared token required on /api/* (set the same value in the web Settings dialog):
ACCESS_TOKEN=
# Token required to write users/settings via /api/admin/* :
ADMIN_TOKEN=
# Comma-separated exact origins allowed by CORS:
ALLOWED_ORIGINS=http://localhost:5173
# Rate limits / cost guards:
VT_RPM=4
VT_DAILY=5000
# Max indicators per single enrich request, and max Claude parses/day:
MAX_BATCH=1000
PARSE_DAILY=2000
# PORT=8787
# Pin the cheap model (Opus is refused in code regardless):
CLAUDE_MODEL=claude-haiku-4-5
# Shared search history retention (days); 0 disables saving:
HISTORY_DAYS=30
