# Copy to .dev.vars (gitignored) and fill in. Loaded by the Node proxy.
VT_API_KEY=
# Optional — enables Claude smart-parse (falls back to regex if unset):
ANTHROPIC_API_KEY=
# Optional — enables Shodan OSINT context on IP rows (ports / services / CVEs):
SHODAN_API_KEY=
# Optional — per-minute cap on Shodan host lookups (free plan ≈ 1/s → 60):
# SHODAN_RPM=60
# Shared token required on /api/* (set the same value in the web Settings dialog):
ACCESS_TOKEN=
# Token required to write users/settings via /api/admin/* :
ADMIN_TOKEN=
# Comma-separated exact origins allowed by CORS:
ALLOWED_ORIGINS=http://localhost:5173
# Rate limits / cost guards:
VT_RPM=4
VT_DAILY=5000
# Max indicators per single enrich request, and max Claude parses/day:
MAX_BATCH=1000
PARSE_DAILY=2000
# PORT=8787
# Pin the cheap model (Opus is refused in code regardless):
CLAUDE_MODEL=claude-haiku-4-5
# Shared search history retention (days); 0 disables saving:
HISTORY_DAYS=30
